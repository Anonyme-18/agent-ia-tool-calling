# LLM : RodiumAI (API compatible OpenAI), clé rd_sk_...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.rodiumai.io/v1
MODEL=openai/gpt-4o-mini
# Recherche et météo
TAVILY_API_KEY=
WEATHER_API_KEY=
# Google OAuth (Calendar + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=
# Email (Gmail + mot de passe d'application)
# Email : gmail_api (défaut, via GOOGLE_REFRESH_TOKEN avec scope gmail.send) ou smtp (repli)
EMAIL_BACKEND=gmail_api
EMAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=
# Notion
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
# Interface
APP_USER=
APP_PASSWORD=
AGENT_TIMEZONE=Africa/Lome
